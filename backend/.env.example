# SmokeStack ERP backend — environment (placeholders only; never commit secrets)
# PostgreSQL connection. On Render, use the database's Internal Connection String.
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/smokestack
# Leave DATABASE_URL empty to use a local SQLite file for dev/tests.

# JWT signing secret — generate a long random value in production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=720

# CORS: comma-separated origins allowed to call the API (your frontend URL).
CORS_ORIGINS=https://smokestack-erp.onrender.com,http://localhost:8000

# How many reverse proxies YOU OPERATE sit in front of this service (SEC HIGH-02).
# The rate limiter attributes each request to the client address `hops` entries from
# the RIGHT of X-Forwarded-For, because only the rightmost entries are appended by
# infrastructure you control — everything to the left of them is attacker-supplied.
#
# 0 means "ignore the header entirely and use the socket peer". That is the SAFE
# DEFAULT and the right value for a direct-to-internet or local deployment: it can
# only ever under-trust. Set it to the REAL number of proxies in the path (Render's
# router alone = 1) and NEVER higher. Setting it higher than the true hop count is
# not a conservative choice — it hands per-IP attribution back to the attacker,
# because the entry it then reads is one the client wrote.
TRUSTED_PROXY_HOPS=0

# Seed demo data on first boot (owner/admin/... accounts + sample records).
SEED_ON_START=true
# Password for the seeded demo accounts. Keep it short (bcrypt caps at 72 bytes).
# Set a real value in the host's secret store; never commit a production secret.
SEED_PASSWORD=demo1234
